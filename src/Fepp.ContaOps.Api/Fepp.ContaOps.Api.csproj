<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>4db6327b-7277-4c56-af0a-cdcf166cf2ea</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.10.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fepp.ContaOps.Application\Fepp.ContaOps.Application.csproj" />
    <ProjectReference Include="..\Fepp.ContaOps.Infrastructure\Fepp.ContaOps.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Fepp.ContaOps.Infrastructure\Email\Templates\templates.json"
             Link="Email\Templates\templates.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Fepp.ContaOps.Infrastructure\Email\Templates\invitation.html"
             Link="Email\Templates\invitation.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Fepp.ContaOps.Infrastructure\Email\Templates\invitation.txt"
             Link="Email\Templates\invitation.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
