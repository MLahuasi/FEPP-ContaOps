# Credencial usada por PostgreSQL dentro del contenedor.
POSTGRES_PASSWORD='replace-with-a-local-database-password'

# Credenciales para ingresar a pgAdmin en http://localhost:5050.
PGADMIN_DEFAULT_EMAIL='admin@example.local'
PGADMIN_DEFAULT_PASSWORD='replace-with-a-local-pgadmin-password'

# Cadena de conexión de la API cuando se ejecuta en el host con dotnet run.
# Debe usar Host=localhost y la misma contraseña de POSTGRES_PASSWORD.
ConnectionStrings__Default='Host=localhost;Port=5432;Database=fepp_contaops_dev;Username=app;Password=replace-with-a-local-database-password'

# Configuración del token JWT.
# Jwt__SigningKey debe tener como mínimo 32 bytes y mantenerse secreta.
Jwt__Issuer='FEPP-ContaOps'
Jwt__Audience='FEPP-ContaOps.Api'
Jwt__SigningKey='replace-with-a-random-key-of-at-least-32-bytes'
Jwt__AccessTokenLifetimeMinutes='15'

# Administrador creado automáticamente por el seed.
BootstrapAdmin__Email='admin@example.local'
BootstrapAdmin__Password='replace-with-an-admin-password'

# Política de contraseña de ASP.NET Core Identity.
Identity__Password__RequiredLength='12'
Identity__Password__RequireUppercase='true'
Identity__Password__RequireLowercase='true'
Identity__Password__RequireDigit='true'
Identity__Password__RequireNonAlphanumeric='true'
Identity__Password__RequiredUniqueChars='6'

# Bloqueo de cuentas de ASP.NET Core Identity.
Identity__Lockout__AllowedForNewUsers='true'
Identity__Lockout__MaxFailedAccessAttempts='5'
Identity__Lockout__DefaultLockoutTimeSpanMinutes='15'

# Invitaciones y activación. La URL debe ser HTTPS.
UserInvitation__TokenLifetimeHours='24'
UserInvitation__ActivationBaseUrl='https://cliente.local/activate'

# SMTP neutral. Gmail usa smtp.gmail.com:587 con StartTls y contraseña de aplicación.
Email__Smtp__Host='smtp.gmail.com'
Email__Smtp__Port='587'
Email__Smtp__SecurityMode='StartTls'
Email__Smtp__Username='sender@example.com'
Email__Smtp__Password='replace-with-a-provider-secret'
Email__Smtp__FromAddress='sender@example.com'
Email__Smtp__FromName='FEPP ContaOps'
Email__Smtp__TimeoutSeconds='30'

# Opcional: por defecto se usa el catálogo distribuido con la aplicación.
Email__Templates__RootPath=''
